rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidConversation(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.modelMode is string &&
             data.modelMode in ['GENERAL', 'DEEP_THINKING', 'FAST', 'SEARCH', 'MULTIMODAL'] &&
             data.lastMessagePreview is string &&
             data.lastMessagePreview.size() <= 200 &&
             data.messageCount is int &&
             data.messageCount >= 0 &&
             data.messageCount <= 10000 &&
             data.pinned is bool &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    function isValidMessage(data, userId, conversationId) {
      return data.userId is string &&
             data.userId == userId &&
             data.conversationId is string &&
             data.conversationId == conversationId &&
             data.role is string &&
             data.role in ['user', 'model'] &&
             data.text is string &&
             data.text.size() <= 32000 &&
             (!('thoughtText' in data) || (data.thoughtText is string && data.thoughtText.size() <= 32000)) &&
             data.modelId is string &&
             data.modelId.size() >= 1 &&
             data.modelId.size() <= 80 &&
             (!('attachmentType' in data) || (data.attachmentType is string && data.attachmentType in ['IMAGE', 'VIDEO', 'AUDIO', 'GENERATED_IMAGE'])) &&
             (!('attachmentLabel' in data) || (data.attachmentLabel is string && data.attachmentLabel.size() <= 160)) &&
             data.sources is list &&
             data.sources.size() <= 10 &&
             (data.sources.size() == 0 || data.sources[0] is string) &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time;
    }

    match /users/{userId}/conversations/{conversationId} {
      allow get: if isOwner(userId) && isValidId(conversationId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       incoming().keys().hasAll(['userId', 'title', 'modelMode', 'lastMessagePreview', 'messageCount', 'pinned', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'modelMode', 'lastMessagePreview', 'messageCount', 'pinned', 'createdAt', 'updatedAt']) &&
                       isValidConversation(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(conversationId) &&
                       isValidConversation(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['pinned', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['modelMode', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['lastMessagePreview', 'messageCount', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'lastMessagePreview', 'messageCount', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(conversationId);

      match /messages/{messageId} {
        allow get: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        allow list: if isOwner(userId) && isValidId(conversationId);

        allow create: if isOwner(userId) &&
                         isValidId(conversationId) &&
                         isValidId(messageId) &&
                         incoming().keys().hasAll(['userId', 'conversationId', 'role', 'text', 'modelId', 'sources', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'conversationId', 'role', 'text', 'thoughtText', 'modelId', 'attachmentType', 'attachmentLabel', 'sources', 'createdAt']) &&
                         isValidMessage(incoming(), userId, conversationId);

        allow update: if false;

        allow delete: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
      }
    }
  }
}
